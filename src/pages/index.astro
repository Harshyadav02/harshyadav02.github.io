---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';
import Skills from '../components/Skills.astro';
import { getCollection } from 'astro:content';
import { sortPosts } from '../lib/utils';
import { profile } from '../data/profile';

const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft)).slice(0, 3);
---

<Layout title="Harsh Yadav">
  <Hero />

  <section class="mx-auto max-w-content px-5 sm:px-8 py-16 border-t border-border/60">
    <div class="flex items-baseline justify-between mb-8">
      <div>
        <p class="log-eyebrow mb-3">blog.latest</p>
        <h2 class="font-mono text-2xl text-ink">Recent writing</h2>
      </div>
      <a href="/blog" class="ml-4 shrink-0 whitespace-nowrap font-mono text-sm text-mint hover:text-mint-bright">read the blog →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        posts.map((post) => (
          <BlogCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            body={post.body}
          />
        ))
      }
    </div>
  </section>

  <Skills />

  <section id="contact" class="mx-auto max-w-content px-5 sm:px-8 py-16 border-t border-border/60 scroll-mt-16">
    <p class="log-eyebrow mb-3">contact.open</p>
    <h2 class="font-mono text-2xl text-ink">{profile.contact.heading}</h2>
    <p class="mt-3 text-ink-muted leading-7 max-w-xl">{profile.contact.body}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={`mailto:${profile.email}`} class="btn-primary">Email me</a>
      <a href={profile.social.linkedin} target="_blank" rel="noopener noreferrer" class="btn-secondary">LinkedIn ↗</a>
      <a href={profile.social.github} target="_blank" rel="noopener noreferrer" class="btn-secondary">GitHub ↗</a>
    </div>
  </section>
</Layout>
