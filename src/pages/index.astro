---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const engagements = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout title="Harsh Yadav">
  <Hero />

  <section class="mx-auto max-w-content px-5 sm:px-8 py-16 border-t border-border/60">
    <div class="flex items-baseline justify-between mb-8">
      <div>
        <p class="log-eyebrow mb-3">clients.online</p>
        <h2 class="font-mono text-2xl text-ink">Client engagements</h2>
      </div>
      <a href="/projects" class="font-mono text-sm text-mint hover:text-mint-bright">all engagements →</a>
    </div>

    <div class="card overflow-hidden max-w-2xl">
      <div class="flex items-center gap-1.5 px-4 py-2.5 border-b border-border bg-surface-raised">
        <span class="w-2.5 h-2.5 rounded-full bg-[#e05252]/70"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#e8c14b]/70"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-mint/70"></span>
        <span class="ml-3 font-mono text-xs text-ink-faint">clients.txt</span>
      </div>
      <div class="font-mono text-sm p-5 sm:p-6 leading-8">
        <p class="text-ink-faint">$ cat clients.txt</p>
        {
          engagements.map((engagement) => (
            <a
              href={`/projects/${engagement.id}/`}
              class="flex flex-wrap items-baseline gap-x-3 text-ink hover:text-mint transition-colors"
            >
              <span class="text-mint select-none">›</span>
              <span>{engagement.data.title}</span>
              <span class="text-ink-faint text-xs">read write-up →</span>
            </a>
          ))
        }
        <span class="text-mint animate-blink">▍</span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-content px-5 sm:px-8 py-16 border-t border-border/60">
    <div class="flex items-baseline justify-between mb-8">
      <div>
        <p class="log-eyebrow mb-3">blog.latest</p>
        <h2 class="font-mono text-2xl text-ink">Recent writing</h2>
      </div>
      <a href="/blog" class="font-mono text-sm text-mint hover:text-mint-bright">read the blog →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        posts.map((post) => (
          <BlogCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            body={post.body}
          />
        ))
      }
    </div>
  </section>

</Layout>
