---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 Not Found" description="Page not found.">
  <section class="mx-auto max-w-content px-5 sm:px-8 py-24 text-center">
    <p class="log-eyebrow justify-center mb-4">error.trace</p>
    <h1 class="font-mono text-4xl text-ink mb-3">404</h1>
    <p class="text-ink-muted mb-8">This route doesn't resolve to anything. It may have moved or never existed.</p>
    <a href="/" class="btn-primary">Back to home</a>
  </section>
</Layout>
