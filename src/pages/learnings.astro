---
import Layout from '../layouts/Layout.astro';

const learnings = [
  {
    title: 'Debug from data, not from instinct',
    body: 'Before touching any code I look at the logs, metrics, and traces. The failure mode is almost always visible in the telemetry before it is in the source.',
  },
  {
    title: 'Resource requests are a contract',
    body: 'Scheduling and autoscaling both read requests and limits. Getting them wrong shows up as throttling, evictions, and inflated cloud bills — not as a nice error message.',
  },
  {
    title: 'Observability is the foundation',
    body: 'You cannot improve what you cannot measure. Instrumenting early — golden signals, structured logs, distributed traces — pays back every time something goes wrong.',
  },
  {
    title: 'Automation without a runbook is tech debt',
    body: 'A pipeline that only one person can operate is a liability. Documentation and known-good procedures are part of the automation, not an afterthought.',
  },
  {
    title: 'Small, reversible changes win',
    body: 'Feature flags, progressive rollouts, and incremental Terraform changes make failures cheap to detect and quick to undo.',
  },
  {
    title: 'Reliability is a habit, not a project',
    body: 'Post-incident reviews, chaos experiments, and steady cleanup keep systems healthy between incidents rather than in reaction to them.',
  },
];
---

<Layout title="Personal Learnings" description="Notes and lessons learned working on cloud-native infrastructure.">
  <section class="mx-auto max-w-content px-5 sm:px-8 py-16">
    <p class="log-eyebrow mb-4">learnings.log --tail</p>
    <h1 class="font-mono text-3xl text-ink mb-3">Personal Learnings</h1>
    <p class="text-ink-muted max-w-2xl leading-7 mb-10">
      Lessons I keep coming back to while building and operating cloud-native infrastructure.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {learnings.map((l) => (
        <article class="card card-hover p-6">
          <h2 class="font-mono text-base text-ink mb-2">{l.title}</h2>
          <p class="text-sm text-ink-muted leading-6">{l.body}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>
