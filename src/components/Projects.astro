---
import { projects } from '../data/projects';
export interface Props {
  featuredOnly?: boolean;
}
const { featuredOnly = false } = Astro.props;
const list = featuredOnly ? projects.filter((p) => p.featured) : projects;
---

<div class="grid sm:grid-cols-2 gap-5">
  {
    list.map((project) => (
      <article class="card card-hover p-6 flex flex-col">
        <h3 class="font-mono text-lg text-ink">{project.title}</h3>
        <p class="text-sm text-ink-muted mt-2 leading-6 flex-1">{project.summary}</p>
        <div class="flex flex-wrap gap-2 mt-4">
          {project.tech.map((t) => (
            <span class="pill">{t}</span>
          ))}
        </div>
      </article>
    ))
  }
</div>
