---
import { getCollection } from 'astro:content';
export interface Props {
  featuredOnly?: boolean;
}
const { featuredOnly = false } = Astro.props;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const list = featuredOnly ? projects.filter((p) => p.data.featured) : projects;
---

<div class="grid sm:grid-cols-2 gap-5">
  {
    list.map((project) => (
      <article class="card card-hover p-6 flex flex-col">
        <a href={`/projects/${project.id}/`} class="group">
          <h3 class="font-mono text-lg text-ink group-hover:text-mint transition-colors">{project.data.title}</h3>
        </a>
        <p class="text-sm text-ink-muted mt-2 leading-6 flex-1">{project.data.summary}</p>
        <div class="flex flex-wrap gap-2 mt-4">
          {project.data.tech.map((t) => (
            <span class="pill">{t}</span>
          ))}
        </div>
        <a href={`/projects/${project.id}/`} class="font-mono text-xs text-mint mt-4 hover:text-mint-bright transition-colors">
          view engagement →
        </a>
      </article>
    ))
  }
</div>
