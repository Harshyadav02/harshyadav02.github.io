---
import { experience } from '../data/experience';
export interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const entries = compact ? experience.slice(0, 1) : experience;
---

<div class="space-y-6">
  {
    entries.map((company) => (
      <article class="card card-hover p-6 relative">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
          <h3 class="font-mono text-lg text-ink">{company.company}</h3>
          <span class="font-mono text-xs text-ink-faint">{company.location}</span>
        </div>

        {company.clients && (
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <span class="font-mono text-xs text-ink-faint">clients:</span>
            {company.clients.map((client) => <span class="pill">{client}</span>)}
          </div>
        )}

        <div class="mt-5 space-y-8">
          {
            company.roles.map((role) => (
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h4 class="font-mono text-sm text-mint font-medium">{role.title}</h4>
                  <span class="font-mono text-xs text-ink-faint">{role.date}</span>
                </div>
                <p class="text-ink-muted text-sm mt-3 leading-6">{role.description}</p>
                <ul class="mt-3 space-y-1.5">
                  {role.responsibilities.map((r) => (
                    <li class="text-sm text-ink-muted flex gap-2">
                      <span class="text-mint mt-0.5">›</span>
                      <span>{r}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </article>
    ))
  }
</div>
